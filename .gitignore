# Numerical output written by running the notebooks
*.OUT
*.pkl
.mpsfolder

# Jupyter
.ipynb_checkpoints

# Live/contact session working copies (local only)
live_sessions/*
contact_session

# Slide editing sources. The .odp decks live here next to their exported PDFs, but
# only the PDFs are published: the sources are multi-MB binaries that would bloat
# history on every re-save.
*.odp

# LaTeX build artifacts. main.pdf is built inside src/ and copied to lecture_notes/,
# so only the published copy at the top of lecture_notes/ is tracked.
lecture_notes/src/main.pdf
lecture_notes/src/*.aux
lecture_notes/src/*.log
lecture_notes/src/*.out
lecture_notes/src/*.toc
lecture_notes/src/*.fdb_latexmk
lecture_notes/src/*.fls
lecture_notes/src/*.synctex.gz

# OS cruft
.DS_Store
